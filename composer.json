{
    "name": "tyhpdef/symfony-browser-kit-impl",
    "description": "Implementation package for tyhpdef/symfony-browser-kit. Require tyhpdef/symfony-browser-kit, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "7.4.17.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/symfony-dom-crawler": "@dev",
                "tyhpdef/symfony-http-foundation": "@dev",
                "tyhpdef/symfony-css-selector": "@dev",
                "tyhpdef/php-ext-dom": "@dev",
                "tyhpdef/php-ext-session": "@dev",
                "tyhpdef/php-ext-pdo": "@dev",
                "tyhpdef/symfony-http-client-contracts": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/symfony-browser-kit"
        }
    },
    "require": {
        "php": ">=8.2",
        "symfony/browser-kit": "7.4.17"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/symfony-dom-crawler": "@dev",
        "tyhpdef/symfony-http-foundation": "@dev",
        "tyhpdef/symfony-css-selector": "@dev",
        "tyhpdef/php-ext-dom": "@dev",
        "tyhpdef/php-ext-session": "@dev",
        "tyhpdef/php-ext-pdo": "@dev",
        "tyhpdef/symfony-http-client-contracts": "@dev"
    }
}
